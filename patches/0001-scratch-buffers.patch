@@ -0,0 +1,307 @@
+//! 未保存の新規タブ（`Untitled-N` 相当）を、内部的には永続データ領域の `.txt` として
+//! 管理するためのパス生成・判定・表示番号の割り当て。
+//!
+//! LSP へバッファを登録するには実ファイル（`project::File`）が必要なため、実ファイルを
+//! 使う。一方でタブには実パスを見せたくないため、`project::File` 自体には手を入れず、
+//! パスが専用ディレクトリ配下かつ決められたファイル名であることをこのモジュールの
+//! 判定関数（[`is_scratch_path`]）で確認し、呼び出し側（editor クレートのタブ表示）が
+//! その場合だけ `Untitled-N` を表示する。
+
+use std::collections::{BTreeSet, HashMap};
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+
+use text::BufferId;
+
+/// 各下書きの実体ファイル名。番号や UUID をファイル名自体に混ぜず、親ディレクトリ名
+/// （`<display_number>-<uuid>`）だけに寄せることで、判定条件を「専用ディレクトリ配下」
+/// 「ファイル名が一致」の2つに単純化する。
+const SCRATCH_BUFFER_FILE_NAME: &str = "buffer.txt";
+
+/// 下書きを置く専用ディレクトリの名前（`paths::temp_dir()` 配下）。
+const SCRATCH_BUFFERS_DIR_NAME: &str = "scratch-buffers";
+
+/// 下書きを保存する専用ディレクトリ。`paths::temp_dir()`（Linux では実際には
+/// `$XDG_RUNTIME_DIR` ではなく `~/.cache/zed` 相当で、再起動しても消えない）配下に
+/// 置く。実ファイルである以上 Hot Exit の復元対象になるため、意図的に残す
+/// （docs/design.md 確定事項2参照。恒久的な保管を積極的に目指すものではないが、
+/// 削除しないことで Hot Exit を機能させることを優先する）。
+pub fn scratch_root_dir() -> PathBuf {
+    paths::temp_dir().join(SCRATCH_BUFFERS_DIR_NAME)
+}
+
+/// `path` が下書き専用の実体ファイルかどうかを判定する。
+///
+/// 単純な文字列プレフィックス一致ではなく、パスのコンポーネント境界で
+/// [`scratch_root_dir`] 配下にあることと、ファイル名が
+/// [`SCRATCH_BUFFER_FILE_NAME`] と一致することに加え、親ディレクトリ名が
+/// `<display_number>-<uuid>` という正確な形式であることまで確認する。これにより、
+/// 偶然似た名前を持つだけの通常のユーザーファイルを誤って下書き扱いしない。
+pub fn is_scratch_path(path: &Path) -> bool {
+    path.file_name().and_then(|name| name.to_str()) == Some(SCRATCH_BUFFER_FILE_NAME)
+        && path.starts_with(scratch_root_dir())
+        && scratch_display_number(path).is_some()
+}
+
+/// パスに埋め込まれた表示番号を返す。パスの形式は
+/// `scratch_root_dir()/<display_number>-<uuid>/buffer.txt` で、`<uuid>` が正しい
+/// UUID でなければ `None`（[`is_scratch_path`] もこれを使って誤判定を防ぐ）。
+pub fn scratch_display_number(path: &Path) -> Option<usize> {
+    let dir_name = path.parent()?.file_name()?.to_str()?;
+    let (number, uuid) = dir_name.split_once('-')?;
+    uuid::Uuid::parse_str(uuid).ok()?;
+    number.parse().ok()
+}
+
+fn active_display_numbers() -> &'static Mutex<BTreeSet<usize>> {
+    static ACTIVE: OnceLock<Mutex<BTreeSet<usize>>> = OnceLock::new();
+    ACTIVE.get_or_init(|| Mutex::new(BTreeSet::new()))
+}
+
+/// 使用中でない最小の表示番号を採番し、使用中として記録する。
+///
+/// 番号はアプリ全体でグローバルに管理する（ウィンドウ単位ではない）。理由は
+/// docs/design.md を参照: ウィンドウ間のタブ移動があっても番号を振り直す必要がなく、
+/// 単一のカウンタで完結するため。
+pub fn allocate_display_number() -> usize {
+    // Even if some earlier panic poisoned this mutex (e.g. a test failing while holding
+    // the guard), the allocator's own invariants don't depend on that panic having left
+    // the set in a torn state (it's a single insert), so recovering here is safe and
+    // keeps later callers from failing for an unrelated reason.
+    let mut numbers = active_display_numbers()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut candidate = 1;
+    while numbers.contains(&candidate) {
+        candidate += 1;
+    }
+    numbers.insert(candidate);
+    candidate
+}
+
+/// `number` を使用中として記録する。既に使用中でも冪等（何もしない）。
+///
+/// 新規下書き作成時は [`allocate_display_number`] が空いている番号を選んで採番する。
+/// 一方、Hot Exit 等で外部から scratch パスのバッファが復元された場合は、番号は
+/// パスに既に埋め込まれている（[`scratch_display_number`]）ので、その番号をこの
+/// 関数で予約する。呼び出し元は `Editor::new_internal` に一元化されている
+/// （経路を問わず、singleton バッファが scratch パスを指していればここを通る）。
+pub fn reserve_display_number(number: usize) {
+    active_display_numbers()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .insert(number);
+}
+
+/// 表示番号を解放し、以後の [`allocate_display_number`] で再利用できるようにする。
+///
+/// 呼び出し側は、そのバッファへの最後の参照（最後の表示）が消えたときにのみこれを
+/// 呼ぶこと。分割ペインで同じ下書きが複数表示されている間は呼んではいけない
+/// （docs/design.md 「3. 分割ペインで最後の表示を閉じた際の扱い」参照）。
+pub fn release_display_number(number: usize) {
+    active_display_numbers()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .remove(&number);
+}
+
+/// 番号とバッファの対応を双方向に保つ。`number_to_buffer` は所有者チェック
+/// （[`release_display_number_owned_by`]）に、`buffer_to_number` は「このバッファが
+/// 持っていた番号」の逆引き（[`display_number_for_buffer`]、保存でファイルパスが
+/// scratch から外れた後は `scratch_display_number` でパスから番号を求められない
+/// ため必要）に使う。
+#[derive(Default)]
+struct Ownership {
+    number_to_buffer: HashMap<usize, BufferId>,
+    buffer_to_number: HashMap<BufferId, usize>,
+}
+
+fn ownership() -> &'static Mutex<Ownership> {
+    static OWNERSHIP: OnceLock<Mutex<Ownership>> = OnceLock::new();
+    OWNERSHIP.get_or_init(|| Mutex::new(Ownership::default()))
+}
+
+/// `number` の所有者を `buffer_id` として記録する。同じ組み合わせを複数回呼んでも
+/// 冪等（分割ペインで同じバッファに対し複数の `Editor` が呼ぶことを想定）。
+///
+/// 保存成功による即時解放（[`release_display_number_owned_by`]）を安全にするための
+/// 前提: `allocate_display_number`／`reserve_display_number` で確保した番号は、
+/// 実際にそれを使うバッファが判明した時点でこれを呼んで紐づけること。
+pub fn associate_display_number_with_buffer(number: usize, buffer_id: BufferId) {
+    let mut ownership = ownership()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    ownership.number_to_buffer.insert(number, buffer_id);
+    ownership.buffer_to_number.insert(buffer_id, number);
+}
+
+/// `buffer_id` に紐づく表示番号を返す（まだ [`release_display_number_owned_by`] で
+/// 解放していなければ）。保存によってバッファのファイルパスが scratch パスから
+/// 外れた後は、そのパスから番号を逆算できない（[`scratch_display_number`] は新しい
+/// パスに対して `None` を返す）ため、このバッファ ID ベースの逆引きが必要になる。
+pub fn display_number_for_buffer(buffer_id: BufferId) -> Option<usize> {
+    ownership()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .buffer_to_number
+        .get(&buffer_id)
+        .copied()
+}
+
+/// `number` の所有者が `buffer_id` と一致する場合にのみ解放する。一致しなければ
+/// 何もしない。
+///
+/// 単純な `release_display_number(number)` だと、同じ番号に対して複数の解放経路
+/// （保存成功時の即時解放、バッファが完全に破棄されたときの `on_release`）が
+/// 独立に登録されうるため、片方が解放した直後にその番号が新しい下書きへ
+/// 再割り当てされ、もう片方が"自分の番号のつもり"でそれを解放してしまう
+/// （＝無関係な別の下書きの番号を奪う）事故が起こりうる。所有者チェックにより、
+/// 既に別のバッファへ再割り当て済みの番号を誤って解放しない。
+pub fn release_display_number_owned_by(number: usize, buffer_id: BufferId) {
+    let mut ownership = ownership()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if ownership.number_to_buffer.get(&number) == Some(&buffer_id) {
+        ownership.number_to_buffer.remove(&number);
+        ownership.buffer_to_number.remove(&buffer_id);
+        drop(ownership);
+        release_display_number(number);
+    }
+}
+
+/// `number` が現在採番済み（未解放）かどうかを返す。分割ペインでの解放タイミング
+/// （最後の表示が消えたときにのみ解放されること）を検証する自動テスト向け。
+#[cfg(any(test, feature = "test-support"))]
+pub fn is_display_number_in_use(number: usize) -> bool {
+    active_display_numbers()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .contains(&number)
+}
+
+/// 表示番号はプロセスグローバルな状態なので、特定の番号（`Untitled-1` など）を
+/// 検証する自動テストは、他のテストと同時に番号を採番して混線しないよう、この
+/// ロックで直列化すること。他クレートのテストからも使えるよう、内部実装ではなく
+/// この関数自体が対象。
+///
+/// 通常の `.unwrap()` にしないのは、直列化対象のテストが assert 失敗でこのロックを
+/// 保持したまま panic した場合に、以降の無関係なテストまで連鎖的に失敗させないため。
+#[cfg(any(test, feature = "test-support"))]
+pub fn test_synchronization_lock() -> std::sync::MutexGuard<'static, ()> {
+    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();
+    LOCK.get_or_init(|| Mutex::new(()))
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+/// 新しい下書きの実体ファイルの絶対パスと表示番号を決める。
+///
+/// ディレクトリ・ファイルの作成はこの関数の呼び出し元（非同期コンテキスト）が行う
+/// ことを想定し、この関数自体はファイルシステムに触れず、パスと番号だけを決める。
+pub fn new_scratch_buffer_path() -> (PathBuf, usize) {
+    let number = allocate_display_number();
+    let uuid = uuid::Uuid::new_v4();
+    let path = scratch_root_dir()
+        .join(format!("{number}-{uuid}"))
+        .join(SCRATCH_BUFFER_FILE_NAME);
+    (path, number)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scratch_paths_round_trip_their_display_number() {
+        let _guard = test_synchronization_lock();
+        let (path, number) = new_scratch_buffer_path();
+        assert!(is_scratch_path(&path));
+        assert_eq!(scratch_display_number(&path), Some(number));
+        release_display_number(number);
+    }
+
+    #[test]
+    fn ordinary_user_files_are_never_mistaken_for_scratch_buffers() {
+        // 偶然ディレクトリ名の一部に "scratch-buffers" という文字列を含むだけの通常の
+        // ユーザーファイルは、専用ディレクトリの直下ではないので誤判定しない。
+        let lookalike = PathBuf::from("/tmp/notes/my-scratch-buffers-ideas/buffer.txt");
+        assert!(!is_scratch_path(&lookalike));
+
+        // ファイル名が一致しない場合も誤判定しない。
+        let wrong_name = scratch_root_dir().join("1-deadbeef").join("notes.txt");
+        assert!(!is_scratch_path(&wrong_name));
+
+        // 親ディレクトリ名が <number>-<uuid> の正確な形式でない場合も誤判定しない
+        // （UUID 部分が不正、番号部分が不正）。
+        let bad_uuid = scratch_root_dir()
+            .join("1-not-a-real-uuid")
+            .join(SCRATCH_BUFFER_FILE_NAME);
+        assert!(!is_scratch_path(&bad_uuid));
+        let bad_number = scratch_root_dir()
+            .join(format!("abc-{}", uuid::Uuid::new_v4()))
+            .join(SCRATCH_BUFFER_FILE_NAME);
+        assert!(!is_scratch_path(&bad_number));
+    }
+
+    #[test]
+    fn reserve_display_number_is_idempotent_and_blocks_reallocation() {
+        let _guard = test_synchronization_lock();
+        reserve_display_number(1);
+        reserve_display_number(1);
+        assert!(is_display_number_in_use(1));
+        // A fresh allocation must skip the reserved number.
+        let allocated = allocate_display_number();
+        assert_ne!(allocated, 1);
+        release_display_number(1);
+        release_display_number(allocated);
+    }
+
+    #[test]
+    fn owned_release_ignores_numbers_reassigned_to_another_buffer() {
+        let _guard = test_synchronization_lock();
+        let buffer_a = BufferId::new(1).unwrap();
+        let buffer_b = BufferId::new(2).unwrap();
+
+        let number = allocate_display_number();
+        associate_display_number_with_buffer(number, buffer_a);
+        assert_eq!(display_number_for_buffer(buffer_a), Some(number));
+
+        // Simulate buffer_a's save-triggered release racing with buffer_b claiming
+        // the same number, then buffer_a's on_release firing afterwards: it must
+        // not steal buffer_b's number.
+        release_display_number_owned_by(number, buffer_a);
+        assert!(!is_display_number_in_use(number));
+        assert_eq!(display_number_for_buffer(buffer_a), None);
+
+        let reallocated = allocate_display_number();
+        assert_eq!(reallocated, number, "the freed number should be reused");
+        associate_display_number_with_buffer(reallocated, buffer_b);
+        assert_eq!(display_number_for_buffer(buffer_b), Some(reallocated));
+
+        // A stale release for buffer_a (e.g. its on_release firing late) must be a
+        // no-op now that the number belongs to buffer_b.
+        release_display_number_owned_by(reallocated, buffer_a);
+        assert!(
+            is_display_number_in_use(reallocated),
+            "stale release from the old owner must not free buffer_b's number"
+        );
+        assert_eq!(display_number_for_buffer(buffer_b), Some(reallocated));
+
+        // The real owner can still release it normally.
+        release_display_number_owned_by(reallocated, buffer_b);
+        assert!(!is_display_number_in_use(reallocated));
+    }
+
+    #[test]
+    fn released_numbers_are_reused_before_allocating_new_ones() {
+        let _guard = test_synchronization_lock();
+        let first = allocate_display_number();
+        let second = allocate_display_number();
+        assert_ne!(first, second);
+        release_display_number(first);
+        let third = allocate_display_number();
+        assert_eq!(first, third);
+        release_display_number(second);
+        release_display_number(third);
+    }
+}
