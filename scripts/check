#!/usr/bin/env bash
# Type-checks and tests the patched checkout produced by scripts/prepare.
#
# Deliberately does NOT set CARGO_TARGET_DIR outside .checkout/zed: Zed's
# dev-mode asset loading (util::dev_repo_root) locates the checkout by
# walking up from the *build output's* path looking for a `.git` entry. If
# CARGO_TARGET_DIR points outside .checkout/zed, that walk finds the wrong
# repository (e.g. this one) and every #[gpui::test] fails trying to load
# assets/settings/default.json -- even on an unpatched checkout. Keep target/
# inside .checkout/zed so the walk lands on the right .git.
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
checkout_dir="$root_dir/.checkout/zed"

# The patch touches workspace::scratch_buffers plus editor's use of it
# (new-tab creation, tab display, save routing). Override via
# SCRATCH_BUFFERS_CARGO_PACKAGES (space-separated) if that changes.
read -ra packages <<< "${SCRATCH_BUFFERS_CARGO_PACKAGES:-editor workspace}"

if [[ ! -d "$checkout_dir/.git" ]]; then
    echo "error: $checkout_dir not found; run scripts/prepare first." >&2
    exit 1
fi

cd "$checkout_dir"
unset CARGO_TARGET_DIR
package_args=()
for package in "${packages[@]}"; do
    package_args+=(-p "$package")
done
cargo check "${package_args[@]}"
cargo test "${package_args[@]}" --lib
